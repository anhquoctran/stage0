{
  "baseVersion": "0.0.4",
  "epoch": "2026-10-01T00:00:00Z",
  "developmentBranch": "origin/develop",
  "leadMinutes": 60,
  "promotion": {
    "requiredCheck": "Release promotion policy",
    "periodTimeZone": "UTC",
    "selection": "all-eligible-source-snapshots-with-human-QA",
    "routes": {
      "beta": {
        "from": "develop",
        "branch": "beta",
        "hotfixMinimumAgeHours": 24
      },
      "stable": {
        "from": "beta",
        "branch": "main",
        "hotfixMinimumAgeHours": 168
      }
    }
  },
  "gitFlow": {
    "protectedBranches": [
      "main",
      "beta",
      "develop"
    ],
    "defaultBaseBranch": "develop",
    "workBranchPrefixes": [
      "feat/",
      "fix/",
      "refactor/",
      "perf/",
      "docs/",
      "test/",
      "chore/"
    ],
    "hotfixPrefix": "hotfix/",
    "riskLevels": {
      "work": {
        "risk": "highest",
        "stability": "unstable"
      },
      "develop": {
        "risk": "highest",
        "stability": "unstable"
      },
      "beta": {
        "risk": "medium",
        "stability": "stabilizing"
      },
      "main": {
        "risk": "low",
        "stability": "stable"
      }
    },
    "syncTargets": {
      "main": [
        "beta",
        "develop"
      ],
      "beta": [
        "develop"
      ]
    }
  },
  "channels": {
    "beta": {
      "branch": "origin/beta",
      "cadence": "monthly",
      "risk": "medium",
      "stability": "stabilizing",
      "releaseDayOfMonth": 27,
      "releaseTimeUtc": "00:00",
      "cron": "0 0 27 * *"
    },
    "stable": {
      "branch": "origin/main",
      "cadence": "quarterly",
      "risk": "low",
      "stability": "stable",
      "releaseDayOfQuarter": 1,
      "releaseTimeUtc": "00:00",
      "cron": "0 0 1 1,4,7,10 *",
      "crons": [
        "0 0 1 1,4,7,10 *"
      ]
    }
  }
}
