{
  "baseVersion": "0.0.1",
  "epoch": "2026-10-01T00:00:00Z",
  "developmentBranch": "origin/develop",
  "leadMinutes": 60,
  "previewActivityHours": 24,
  "gitFlow": {
    "protectedBranches": ["main", "beta", "nightly", "develop"],
    "defaultBaseBranch": "develop",
    "workBranchPrefixes": ["feat/", "fix/", "refactor/", "perf/", "docs/", "test/", "chore/"],
    "hotfixPrefix": "hotfix/",
    "riskLevels": {
      "work": { "risk": "highest", "stability": "unstable" },
      "develop": { "risk": "highest", "stability": "unstable" },
      "nightly": { "risk": "high", "stability": "preview" },
      "beta": { "risk": "medium", "stability": "stabilizing" },
      "main": { "risk": "low", "stability": "stable" }
    },
    "syncTargets": {
      "main": ["beta", "nightly", "develop"],
      "beta": ["nightly", "develop"],
      "nightly": ["develop"]
    }
  },
  "channels": {
    "nightly": {
      "branch": "origin/nightly",
      "cadence": "daily",
      "risk": "high",
      "stability": "preview",
      "releaseTimeUtc": "00:00",
      "cron": "0 23 * * *"
    },
    "beta": {
      "branch": "origin/beta",
      "cadence": "monthly",
      "risk": "medium",
      "stability": "stabilizing",
      "releaseDayOfMonth": 27,
      "releaseTimeUtc": "00:00",
      "cron": "0 23 26 * *"
    },
    "stable": {
      "branch": "origin/main",
      "cadence": "quarterly",
      "risk": "low",
      "stability": "stable",
      "releaseDayOfQuarter": 1,
      "releaseTimeUtc": "00:00",
      "cron": "0 23 31 3,12 *",
      "crons": ["0 23 31 3,12 *", "0 23 30 6,9 *"]
    }
  }
}
