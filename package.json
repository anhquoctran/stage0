{
  "name": "stage0",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-pnpm.mjs",
    "dev": "node scripts/dev.mjs --web",
    "dev:web": "node scripts/dev.mjs --web",
    "dev:app": "node scripts/dev.mjs --app",
    "dev:desktop": "node scripts/dev.mjs --app",
    "reset:app-state": "node scripts/reset-app-state.mjs",
    "build": "node scripts/build.mjs --web-only",
    "build:web": "node scripts/build.mjs --web-only",
    "build:app": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:backend-size": "node scripts/check-backend-size.mjs",
    "check:frontend-size": "node scripts/check-frontend-size.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:version": "node --test scripts/bump-version.test.mjs",
    "test:about": "node --test scripts/generate-about-info.test.mjs",
    "preview": "vite preview",
    "preview:site": "vite website --port 3333",
    "tauri": "tauri",
    "version:set": "node scripts/prepare-release.mjs set",
    "audit:i18n-ui": "node scripts/audit-i18n-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@git-diff-view/react": "^0.1.7",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.11",
    "marked": "^18.0.14",
    "overlayscrollbars": "^2.17.0",
    "overlayscrollbars-react": "^0.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.9",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "author": "Anh Quoc Tran",
  "license": "MIT"
}
