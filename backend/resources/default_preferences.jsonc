{
  "schemaVersion": 1,
  "keymap": {
    "preset": "stage0",
    "overrides": []
  },
  "general": {
    "showInlineBlame": true,
    "streamResponse": true,
    "enableCodeReviewAssist": true,
    "launchAtStartup": true,
    "startInBackground": false,
    "explorerContextMenu": false,
    "addToPath": false
  },
  "appearance": {
    "themeMode": "system",
    "uiFont": { "fontFamily": "IBM Plex Sans" },
    "markdownFont": {
      "fontFamily": "Arial",
      "codeFontFamily": "Fira Code",
      "editorFontFamily": "Fira Code",
      "fontSize": 14,
      "headingFontWeight": 600
    },
    "viewerFont": {
      "fontFamily": "Fira Code",
      "fontSize": 13,
      "isBold": false,
      "isItalic": false,
      "isUnderline": false,
      "lineSpacing": 1.5,
      "enableLigatures": true
    }
  },
  "ai": {},
  "reviewers": [],
  "sandbox": {
    "type": "in_memory"
  },
  "git": {
    "binaryId": "system-default",
    "binaryPath": "git"
  },
  "notifications": {
    "channels": {
      "aiReview": true,
      "gitSync": true,
      "guardrails": true
    }
  }
}
